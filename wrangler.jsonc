// Cloudflare Workers config: Rooster is static files only, no server code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rooster",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Angular 22 writes the site one level down, in browser/.
    "directory": "./dist/rooster/browser",
    // Any unknown path gets index.html, so the app always loads.
    "not_found_handling": "single-page-application"
  }
}
